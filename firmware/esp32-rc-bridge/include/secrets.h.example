// Copy to secrets.h (git-ignored, never committed) and fill in. ADR-0029.
//   cp include/secrets.h.example include/secrets.h
// Make a key:      python -c "import secrets; print(secrets.token_hex(32))"
// Make a password: python -c "import secrets; print(secrets.token_urlsafe(18))"
// The laptop reads RCB_PSK_HEX from this same file (`pnt rc --key-file`).
#pragma once

#define RCB_AP_SSID "pnt-rc"                    // the bridge's own 2.4 GHz access point
#define RCB_AP_PASSWORD "change-me-at-least-8"  // WPA2, 8 to 63 characters
#define RCB_PSK_HEX "replace-with-64-hex-digits-from-secrets.token_hex(32)"
