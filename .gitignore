# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Data: raw sessions never go in git (ADR-0007). Reference CSVs do.
data/sessions/*
!data/sessions/.gitkeep
*.mcap
*.cu8
!tests/fixtures/**/*.mcap

# Analysis outputs: figures are committed, bulky run data is not
analysis/results/runs/

# Confidential: the kickoff deck is marked "Confidential—Not for public consumption"
Kick Off Presentation Combined.pdf
*.confidential.*

# Firmware build output
firmware/**/.pio/

# Commit stamp `just pi-deploy` copies to the Pi
.pnt-commit

# Editors, OS, agents
.vscode/
.idea/
.DS_Store
.claude/
.env
.env.*

# Sionna RT trial (analysis/sionna_campus.py): its own environment and the raw OSM extract
.sionna/
osm.json

# Firmware secrets (PSKs, Wi-Fi passwords): created by hand, never committed (ADR-0029)
firmware/**/secrets.h
